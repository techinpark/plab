# Tokscale Team Configuration
# 팀 내부 배포를 위한 환경 설정 템플릿
#
# 사용법:
#   1. 이 파일을 .env.team으로 복사합니다
#   2. 각 설정값을 팀 환경에 맞게 수정합니다
#   3. docker-compose --env-file .env.team up -d 실행

# ═══════════════════════════════════════════════════════════════
# Database Configuration (PostgreSQL)
# ═══════════════════════════════════════════════════════════════
POSTGRES_USER=tokscale
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=tokscale
POSTGRES_PORT=5432

# ═══════════════════════════════════════════════════════════════
# GitHub OAuth Configuration
# ═══════════════════════════════════════════════════════════════
# GitHub OAuth App 생성 방법:
#   1. https://github.com/settings/developers 접속
#   2. "New OAuth App" 클릭
#   3. 다음 정보 입력:
#      - Application name: Tokscale Team
#      - Homepage URL: http://your-internal-server:3000
#      - Authorization callback URL: http://your-internal-server:3000/api/auth/github/callback
#   4. Register application 후 Client ID와 Secret 복사
#
# 팀 GitHub Organization의 OAuth App을 사용하면 팀원만 접근 가능하게 설정할 수 있습니다

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ═══════════════════════════════════════════════════════════════
# Application Configuration
# ═══════════════════════════════════════════════════════════════
# 팀 내부 서버의 URL (외부에서 접근 가능한 URL)
# 예: http://tokscale.internal.company.com
#     http://192.168.1.100:3000
NEXT_PUBLIC_URL=http://localhost:3000

# 프론트엔드 포트 (기본: 3000)
FRONTEND_PORT=3000

# 세션 암호화 키 (자동 생성되지만 직접 설정 권장)
# openssl rand -base64 32 명령으로 생성 가능
AUTH_SECRET=

# ═══════════════════════════════════════════════════════════════
# Team Settings (Optional)
# ═══════════════════════════════════════════════════════════════
# 팀 이름 (대시보드에 표시)
TEAM_NAME=My Team

# 공개 리더보드 비활성화 (팀 내부 전용)
PRIVATE_MODE=true
